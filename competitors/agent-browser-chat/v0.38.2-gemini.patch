+/// Parses Google's "Please retry in 51.46s." hint out of an error body.
+fn retry_hint_from_body(body: &str) -> Option<f64> {
+    let rest = &body[body.find("retry in ")? + "retry in ".len()..];
+    let end = rest.find('s')?;
+    rest[..end].trim().parse::<f64>().ok()
+}
+
+/// Extras aligned with `collect_tool_calls`' index order.
+fn collect_tool_extras(
+    calls: &std::collections::HashMap<usize, (String, String, String)>,
+    extras: &mut std::collections::HashMap<usize, Value>,
+) -> Vec<Option<Value>> {
+    let mut indices: Vec<usize> = calls.keys().copied().collect();
+    indices.sort();
+    indices.into_iter().map(|i| extras.remove(&i)).collect()
