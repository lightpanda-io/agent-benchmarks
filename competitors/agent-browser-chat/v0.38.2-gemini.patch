+/// Abort routes for every pattern in `AGENT_BROWSER_BLOCKED_URLS`
+/// (comma-separated, `*` wildcards, same matching as `network route`).
+/// They are installed when the daemon starts, so every session and target
+/// gets them before the first navigation, on either engine.
+fn blocked_url_routes() -> Vec<RouteEntry> {
+    env::var("AGENT_BROWSER_BLOCKED_URLS")
+        .unwrap_or_default()
+        .split(',')
+        .map(str::trim)
+        .filter(|p| !p.is_empty())
+        .map(|p| RouteEntry {
+            url_pattern: p.to_string(),
+            response: None,
+            abort: true,
+            resource_types: Vec::new(),
+        })
+        .collect()
+}
